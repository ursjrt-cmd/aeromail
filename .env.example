# Public URL of your app (Render URL while testing; custom app domain after DNS setup)
NEXT_PUBLIC_APP_URL=https://mail.aero.ist

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend -> API Keys / Domains / Webhooks
RESEND_API_KEY=re_your_actual_key
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
RESEND_REGION=us-east-1

# Used to avoid custom-domain middleware rewriting the main app host.
# Comma-separated extra app hosts may be included.
APP_HOSTNAMES=mail.aero.ist,your-service.onrender.com
